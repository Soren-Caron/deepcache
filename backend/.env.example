# Copy to backend/.env and fill in. .env is gitignored — never commit it.

NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Matches docker-compose.yml
DATABASE_URL=postgres://deepcache:deepcache@127.0.0.1:5432/deepcache

# Shared with game servers for HMAC-signed telemetry ingest (M3).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# Salt for pseudonymising player IDs. Changing it breaks continuity of all
# existing player analytics, so set it once and keep it.
PLAYER_SALT=

# OVERSEER (M4). Never put this in a Roblox script.
ANTHROPIC_API_KEY=

# Roblox IDs, filled in after creating the experience (M0-8).
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
