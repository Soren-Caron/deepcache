# Copy to backend/.env and fill in. .env is gitignored — never commit it.

NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Matches docker-compose.yml
DATABASE_URL=postgres://deepcache:deepcache@127.0.0.1:5432/deepcache

# Shared with game servers for HMAC-signed telemetry ingest (M3).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# Salt for pseudonymising player IDs. Changing it breaks continuity of all
# existing player analytics, so set it once and keep it.
PLAYER_SALT=

# OVERSEER (M4). Self-hosted via Ollama, not a cloud API -- see docs/05
# §Model selection and cost. Defaults below match a local `ollama serve`
# with `ollama pull llama3.2:3b` and `ollama pull llama3.1:8b` already run;
# only set these if your setup differs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TICK_MODEL=llama3.2:3b
OLLAMA_BRIEFING_MODEL=llama3.1:8b

# Roblox IDs, filled in after creating the experience (M0-8).
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
